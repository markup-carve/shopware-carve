{% sw_extends '@Storefront/storefront/page/product-detail/description.html.twig' %}

{% block page_product_detail_description %}
    {% set carveSource = product.translated.customFields.carve_body ?? product.customFields.carve_body ?? null %}
    {% set carvePlacement = config('ShopwareCarve.config.productPlacement') ?? 'append' %}
    {% if carveSource and carvePlacement == 'before' %}
        <div class="carve-content carve-product-description">{{ carveSource|carve_ctx(context) }}</div>
    {% endif %}
    {% if not carveSource or carvePlacement != 'replace' %}{{ parent() }}{% endif %}
    {% if carveSource and carvePlacement != 'before' %}
        <div class="carve-content carve-product-description">{{ carveSource|carve_ctx(context) }}</div>
    {% endif %}
{% endblock %}
