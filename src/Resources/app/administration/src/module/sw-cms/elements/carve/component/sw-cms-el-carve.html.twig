{% block sw_cms_el_carve %}
    <div class="sw-cms-el-carve">
        <carve-editor v-if="element.config.content.source === 'static'" :value="element.config.content.value"
            :includes="true" :read-only="true" :namespace="'cms-' + element.id" />
        <p v-else>Carve content comes from the mapped entity field.</p>
    </div>
{% endblock %}
