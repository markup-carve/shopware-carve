{% block sw_cms_el_config_carve %}
    <carve-inherit-wrapper field="content" :element="element" label="Carve content">
        <template #default="{ isInherited }">
            <sw-cms-mapping-field v-model:config="element.config.content" value-types="string" :disabled="isInherited">
                <carve-editor v-if="element.config.content.source === 'static'" :value="element.config.content.value"
                    :includes="true" :disabled="isInherited" :namespace="'cms-' + element.id" @update:value="updateContent" />
                <template #preview="{ demoValue }">
                    <carve-editor :value="demoValue || ''" :read-only="true" :namespace="'cms-' + element.id" />
                </template>
            </sw-cms-mapping-field>
        </template>
    </carve-inherit-wrapper>
{% endblock %}
